{
  "name": "@carnivore/plugin-sdk",
  "version": "1.0.0",
  "type": "module",
  "description": "Official Carnivore Plugin SDK for Node.js and Bun",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "node_preload.mjs",
    "package.json"
  ],
  "dependencies": {},
  "scripts": {
    "build": "../../../web/node_modules/.bin/tsc -p tsconfig.json",
    "typecheck": "../../../web/node_modules/.bin/tsc -p tsconfig.json --noEmit",
    "test": "../../../web/node_modules/.bin/vitest run --config vitest.config.ts"
  }
}
