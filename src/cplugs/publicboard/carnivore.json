{
  "kind": "cplug",
  "id": "publicboard",
  "name": "public review links",
  "version": "0.1.0",
  "api_version": 1,
  "min_app_version": "1.16.1",
  "author": "Joe (ccsliinc)",
  "license": "MIT",
  "tier": "builtin",
  "scope": [
    "global"
  ],
  "icon": "plug",
  "default_enabled": false,
  "requires": [
    {
      "id": "reviewboard",
      "kind": "cplug"
    }
  ],
  "permissions": [
    {
      "name": "agent_writes"
    }
  ],
  "owns": {
    "routes": [
      "/links",
      "/links/{link_id}",
      "/status"
    ],
    "strings": [
      "cplug.publicboard."
    ],
    "tests": [
      "tests/python/cplugs/publicboard/",
      "web/src/cplugs/publicboard/"
    ],
    "styles": [
      "share-link.css"
    ],
    "style_guide": [
      "web/src/cplugs/publicboard/ShareLinkKey.svelte",
      "web/src/cplugs/publicboard/ShareLinkModal.svelte",
      "web/src/cplugs/publicboard/share-link.css"
    ],
    "contributions": [
      "board.header_key",
      "page.row_action"
    ]
  },
  "data": []
}
