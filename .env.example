HOST=0.0.0.0
PORT=8000

CARNIVORE_DEV_RELOAD=false

CLOUDE_DEV_RELOAD=false

DEFAULT_WORKING_DIR=~/carnivore-projects
SESSION_TIMEOUT=3600

CLAUDE_CLI_PATH=/path/to/claude

LOG_LEVEL=ERROR
LOG_BUFFER_SIZE=1000
LOG_FILE_RETENTION=7

CARNIVORE_STATE_DIR=

CLOUDE_STATE_DIR=

LOG_DIRECTORY=

API_KEY=

TOTP_SECRET=
JWT_SECRET=

AUTH_CONFIG_FILE=./config.json

CLOUDE_BIND_IP=127.0.0.1
CLOUDE_PROJECT_PATH=./projects
CLOUDE_LOG_DIR=./logs
