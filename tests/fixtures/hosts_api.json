    {
      "title": "add, 422 key is not a field the caller may set",
      "method": "POST",
      "path": "/api/v1/hosts",
      "request": {
        "key": "evil",
        "label": "x",
        "ssh_target": "studio"
      },
      "status": 422,
      "response": {
        "detail": [
          {
            "type": "extra_forbidden",
            "loc": [
              "body",
              "key"
            ],
            "msg": "Extra inputs are not permitted",
            "input": "evil"
          }
        ]
      }
    },
    {
      "title": "add, 400 a leading '-' would be an ssh option",
      "method": "POST",
      "path": "/api/v1/hosts",
      "request": {
        "label": "x",
        "ssh_target": "-oProxyCommand=touch /tmp/pwned"
      },
      "status": 400,
      "response": {
        "detail": {
          "code": "host_target_invalid",
          "detail": "that ssh address is not valid.",
          "reason": "an ssh target is an alias or user@host: letters, digits, '.', '_', '+' and '-', each part starting with a letter, digit or '_'"
        }
      }
    },
    {
      "title": "add, 400 a host part starting '-'",
      "method": "POST",
      "path": "/api/v1/hosts",
      "request": {
        "label": "x",
        "ssh_target": "alex@-oProxyCommand=x"
      },
      "status": 400,
      "response": {
        "detail": {
          "code": "host_target_invalid",
          "detail": "that ssh address is not valid.",
          "reason": "an ssh target is an alias or user@host: letters, digits, '.', '_', '+' and '-', each part starting with a letter, digit or '_'"
        }
      }
    },
    {
      "title": "add, 400 a shell metacharacter",
      "method": "POST",
      "path": "/api/v1/hosts",
      "request": {
        "label": "x",
        "ssh_target": "studio;id"
      },
      "status": 400,
      "response": {
        "detail": {
          "code": "host_target_invalid",
          "detail": "that ssh address is not valid.",
          "reason": "an ssh target is an alias or user@host: letters, digits, '.', '_', '+' and '-', each part starting with a letter, digit or '_'"
        }
      }
    },
    {
      "title": "add, 400 port out of range",
      "method": "POST",
      "path": "/api/v1/hosts",
      "request": {
        "label": "x",
        "ssh_target": "studio",
        "ssh_port": 70000
      },
      "status": 400,
      "response": {
        "detail": {
          "code": "host_port_invalid",
          "detail": "the request was not valid. check what you entered and try again.",
          "reason": "an ssh port is an integer from 1 to 65535"
        }
      }
    },
    {
      "title": "add, 400 the product's own socket (D1)",
      "method": "POST",
      "path": "/api/v1/hosts",
      "request": {
        "label": "x",
        "ssh_target": "studio",
        "socket": "carnivore"
      },
      "status": 400,
      "response": {
        "detail": {
          "code": "host_socket_reserved",
          "detail": "the request was not valid. check what you entered and try again.",
          "reason": "'carnivore' is the socket Carnivore runs its own sessions on; a remote host gets its own, like 'carnivore-remote'"
        }
      }
    },
    {
      "title": "add, 400 label invalid",
