    {
      "title": "list, empty install",
      "method": "GET",
      "path": "/api/v1/blueprints",
      "request": null,
      "status": 200,
      "response": {
        "status": "ok",
        "blueprints": [],
        "detail": null
      }
    },
    {
      "title": "create",
      "method": "POST",
      "path": "/api/v1/blueprints",
      "request": {
        "spec": {
          "name": "Team",
          "sessions": [
            {
              "label": "api",
              "family": "claude",
              "folder": {
                "mode": "existing",
                "path": "<tmp>/proj"
              },
              "model": "anthropic/claude-opus-4",
              "opening_prompt": "read the README and run the tests"
            },
            {
              "label": "web",
              "family": "codex",
              "folder": {
                "mode": "worktree",
                "repo_path": "<tmp>/app",
                "base_branch": "master",
                "branch": "feat/web"
              }
            }
          ]
        }
      },
      "status": 200,
      "response": {
